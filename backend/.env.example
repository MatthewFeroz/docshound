APP_ENV=development

# Optional. Defaults to backend/data/docshound.db, with automatic fallback to
# data/docshound.db for installations created before the frontend/backend split.
DOCSHOUND_DB_PATH=

# Optional server-managed credential for authenticated deep scans and creating
# documentation pull requests. In local development, supply one token through
# the homepage instead; it is held only in backend process memory. Publishing
# requires Contents and Pull requests read/write access on the destination.
GITHUB_TOKEN=

# Recommended. Routes LLM calls through Merge Gateway with Gemini 3.7 Flash
# first and GPT-5.6 Luna as the fallback. Both use default reasoning.
MERGE_GATEWAY_API_KEY=
MERGE_GATEWAY_BASE_URL=https://api-gateway.merge.dev/v1/openai
MERGE_GATEWAY_PRIMARY_MODEL=google/gemini-3.7-flash
MERGE_GATEWAY_FALLBACK_MODEL=openai/gpt-5.6-luna

# Optional backwards-compatible direct OpenAI configuration. Used only when
# MERGE_GATEWAY_API_KEY is not set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Recommended. DocsHound sends its OpenTelemetry/OpenInference spans to
# LangSmith over OTLP by default. LANGSMITH_TRACING is not needed because the
# canonical trace stream is exported directly through OpenTelemetry.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=docshound
# Only required when a LangSmith key belongs to multiple workspaces.
LANGSMITH_WORKSPACE_ID=
# Optional for non-US or self-hosted LangSmith. Defaults to the US API.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional override for a vendor-neutral collector or another OTLP backend.
# Explicit OTLP configuration takes precedence over the LangSmith default.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=docshound

# Optional privacy controls for automatically instrumented model spans.
OPENINFERENCE_HIDE_INPUTS=false
OPENINFERENCE_HIDE_OUTPUTS=false

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
