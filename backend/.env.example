APP_ENV=development

# Optional. Defaults to backend/data/docshound.db, with automatic fallback to
# data/docshound.db for installations created before the frontend/backend split.
DOCSHOUND_DB_PATH=

# Required for authenticated deep scans. In local development this can also be
# supplied through the homepage and held only in backend process memory.
GITHUB_TOKEN=

# Optional. Enables creating documentation branches and pull requests.
# Use a fine-grained token with Contents and Pull requests read/write access.
GITHUB_WRITE_TOKEN=

# Recommended. Routes LLM calls through Merge Gateway with Gemini 3.7 Flash
# first and GPT-5.6 Luna as the fallback. Both use default reasoning.
MERGE_GATEWAY_API_KEY=
MERGE_GATEWAY_BASE_URL=https://api-gateway.merge.dev/v1/openai
MERGE_GATEWAY_PRIMARY_MODEL=google/gemini-3.7-flash
MERGE_GATEWAY_FALLBACK_MODEL=openai/gpt-5.6-luna

# Optional backwards-compatible direct OpenAI configuration. Used only when
# MERGE_GATEWAY_API_KEY is not set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional. Export OpenTelemetry/OpenInference agent traces over OTLP/HTTP.
# Use a collector base URL or set OTEL_EXPORTER_OTLP_TRACES_ENDPOINT directly.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=docshound

# Optional privacy controls for automatically instrumented model spans.
OPENINFERENCE_HIDE_INPUTS=false
OPENINFERENCE_HIDE_OUTPUTS=false

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
