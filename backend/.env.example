APP_ENV=development

# Optional. Defaults to backend/data/docshound.db, with automatic fallback to
# data/docshound.db for installations created before the frontend/backend split.
DOCSHOUND_DB_PATH=

# Required for higher GitHub rate limits. Public unauthenticated requests work for small demos.
GITHUB_TOKEN=

# Optional. Enables creating documentation branches and pull requests.
# Use a fine-grained token with Contents and Pull requests read/write access.
GITHUB_WRITE_TOKEN=

# Optional. Enables LLM clustering instead of heuristic clustering.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
